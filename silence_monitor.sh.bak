#!/usr/bin/env bash

AUDIO_FILE="/tmp/stewart_mic.wav"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Wait until audio file is created and has some data
while [ ! -f "$AUDIO_FILE" ] || [ $(stat -c %s "$AUDIO_FILE") -lt 44 ]; do
    sleep 0.1
done

# Run ffmpeg to detect silence (2 seconds threshold, -35dB)
# We read the output in real-time. If silence_start is detected, we trigger stop.
ffmpeg -i "$AUDIO_FILE" -af "silencedetect=noise=-35dB:d=2" -f null - 2>&1 | \
while read line; do
    if echo "$line" | grep -q "silence_start"; then
        # Silence detected! Auto-stop recording
        bash "$SCRIPT_DIR/stt.sh" stop
        break
    fi
done
