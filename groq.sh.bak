#!/usr/bin/env bash
# Stewart AI - Groq API Backend

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$SCRIPT_DIR/.env"
MESSAGES_FILE="${1:-/tmp/stewart_req.json}"

# Load env
if [ -f "$ENV_FILE" ]; then
    set -a; source "$ENV_FILE"; set +a
fi

KEY="${GROQ_API_KEY:-}"
if [ -z "$KEY" ]; then
    KEY=$(jq -r '.lumi.apiKey // empty' ~/.config/hypr/settings.json 2>/dev/null)
fi
MODEL="${GROQ_MODEL:-llama-3.1-8b-instant}"

# Split KEY by comma into an array to support multiple keys
IFS=',' read -ra KEYS <<< "$KEY"
if [ ${#KEYS[@]} -eq 0 ]; then
    echo "NO_KEY"
    exit 1
fi

# Read messages from file
MESSAGES=$(cat "$MESSAGES_FILE" 2>/dev/null)
if [ -z "$MESSAGES" ]; then
    echo "ERROR:No messages file"
    exit 1
fi

# Build payload safely with jq
PAYLOAD=$(jq -n \
    --argjson messages "$MESSAGES" \
    --arg model "$MODEL" \
    '{"model": $model, "messages": $messages, "max_tokens": 1024, "temperature": 0.7}')

SUCCESS=false
ERR_MSG=""

for CURRENT_KEY in "${KEYS[@]}"; do
    # Trim whitespace
    CURRENT_KEY=$(echo "$CURRENT_KEY" | xargs)
    if [ -z "$CURRENT_KEY" ]; then continue; fi

    # Call Groq API
    RESPONSE=$(curl -s --max-time 30 \
        "https://api.groq.com/openai/v1/chat/completions" \
        -H "Authorization: Bearer $CURRENT_KEY" \
        -H "Content-Type: application/json" \
        -d "$PAYLOAD")

    if [ $? -ne 0 ]; then
        ERR_MSG="Connection failed. Check your internet."
        continue
    fi

    # Check for API error (e.g., rate limit, invalid key)
    ERR=$(echo "$RESPONSE" | jq -r '.error.message // empty')
    if [ -n "$ERR" ]; then
        ERR_MSG="$ERR"
        continue
    fi

    # Extract content
    CONTENT=$(echo "$RESPONSE" | jq -r '.choices[0].message.content // empty')
    if [ -z "$CONTENT" ]; then
        ERR_MSG="Unknown API error"
        continue
    fi

    # Success!
    SUCCESS=true
    break
done

if [ "$SUCCESS" = false ]; then
    echo "ERROR:$ERR_MSG"
    quickshell ipc call lumi groqError "$ERR_MSG"
    exit 1
fi

echo "$CONTENT"

quickshell ipc call lumi groqComplete "$CONTENT"

AUTOSPEAK="${2:-false}"
if [ "$AUTOSPEAK" = "true" ]; then
    python3 "$SCRIPT_DIR/tts.py" "$CONTENT"
fi

quickshell ipc call lumi ttsComplete
